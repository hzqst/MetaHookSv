<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:BSPLocalizationTools.GUI.ViewModels"
    x:Class="BSPLocalizationTools.GUI.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Title="{Binding Strings.AppTitle}"
    Width="980"
    Height="680"
    MinWidth="780"
    MinHeight="560">
  <Border Padding="16">
    <TabControl>
      <TabItem Header="{Binding Strings.TranslateTab}">
        <Grid RowDefinitions="Auto,*,Auto,160" RowSpacing="12">
          <Grid ColumnDefinitions="*,140,140" ColumnSpacing="8">
            <TextBox Text="{Binding OutLang}" Watermark="{Binding Strings.TargetLanguage}" />
            <Button Grid.Column="1" Content="{Binding Strings.AddBsp}" Click="AddBspButton_Click" />
            <Button Grid.Column="2" Content="{Binding Strings.Clear}" Click="ClearButton_Click" />
          </Grid>

          <ListBox
              Grid.Row="1"
              ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TranslationItemViewModel">
                <Grid ColumnDefinitions="4*,200,2*,2*" ColumnSpacing="8" MinHeight="30">
                  <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding OutputPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding ErrorMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="2" ColumnDefinitions="*,120,120" ColumnSpacing="8">
            <ProgressBar
                Minimum="0"
                Maximum="1"
                Value="{Binding OverallProgress}"
                Height="20"
                VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{Binding Strings.Start}" Command="{Binding StartTranslationCommand}" />
            <Button Grid.Column="2" Content="{Binding Strings.Cancel}" Command="{Binding CancelTranslationCommand}" />
          </Grid>

          <TextBox
              Grid.Row="3"
              Text="{Binding LogText}"
              IsReadOnly="True"
              AcceptsReturn="True"
              TextWrapping="Wrap" />
        </Grid>
      </TabItem>

      <TabItem Header="{Binding Strings.SettingsTab}">
        <ScrollViewer>
          <Border Padding="0,0,20,0">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
            <TextBlock Text="{Binding Strings.ConfigurationFile}" FontWeight="SemiBold" />
            <Grid Grid.Row="1" ColumnDefinitions="*,110,110" ColumnSpacing="8">
              <TextBox Text="{Binding EnvPath}" />
              <Button Grid.Column="1" Content="{Binding Strings.Load}" Command="{Binding LoadConfigurationCommand}" />
              <Button Grid.Column="2" Content="{Binding Strings.Save}" Command="{Binding SaveConfigurationCommand}" />
            </Grid>

            <TextBlock Grid.Row="2" Text="{Binding Strings.PromptFile}" FontWeight="SemiBold" />
            <Grid Grid.Row="3" ColumnDefinitions="*,120" ColumnSpacing="8">
              <TextBox Text="{Binding PromptFilePath}" Watermark="{Binding Strings.PromptFileWatermark}" />
              <Button Grid.Column="1" Content="{Binding Strings.Browse}" Click="BrowsePromptButton_Click" />
            </Grid>

            <TextBlock Grid.Row="4" Text="{Binding Strings.PromptEditor}" FontWeight="SemiBold" />
            <Grid Grid.Row="5" RowDefinitions="Auto,Auto" RowSpacing="8">
              <Grid ColumnDefinitions="*,150,150,150" ColumnSpacing="8">
                <TextBlock Text="{Binding Strings.PromptEditorWatermark}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="{Binding Strings.LoadBuiltInPrompt}" Command="{Binding LoadBuiltInPromptCommand}" />
                <Button Grid.Column="2" Content="{Binding Strings.ReloadPromptFromFile}" Command="{Binding ReloadPromptFromFileCommand}" />
                <Button Grid.Column="3" Content="{Binding Strings.SavePromptFile}" Click="SavePromptButton_Click" />
              </Grid>
              <TextBox
                  Grid.Row="1"
                  Text="{Binding PromptText}"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  MinHeight="140"
                  VerticalContentAlignment="Top"
                  Watermark="{Binding Strings.PromptEditorWatermark}" />
            </Grid>

            <TextBlock Grid.Row="6" Text="{Binding Strings.Llm}" FontWeight="SemiBold" />
            <Grid Grid.Row="7" ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
              <TextBlock Text="{Binding Strings.Model}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding LlmModel}" Watermark="gpt-5.5" />
              <TextBlock Grid.Row="1" Text="{Binding Strings.ApiKey}" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LlmApiKey}" PasswordChar="*" />
              <TextBlock Grid.Row="2" Text="{Binding Strings.BaseUrl}" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LlmBaseUrl}" Watermark="https://api.openai.com/v1" />
              <TextBlock Grid.Row="3" Text="{Binding Strings.Temperature}" VerticalAlignment="Center" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LlmTemperature}" Watermark="optional" />
              <TextBlock Grid.Row="4" Text="{Binding Strings.ReasoningEffort}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding EffortOptions}" SelectedItem="{Binding LlmEffort}" />
              <TextBlock Grid.Row="5" Text="{Binding Strings.FakeAs}" VerticalAlignment="Center" />
              <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding LlmFakeAs}" Watermark="codex" />
            </Grid>

            <TextBlock Grid.Row="8" Text="{Binding Strings.Defaults}" FontWeight="SemiBold" />
            <Grid Grid.Row="9" ColumnDefinitions="160,*" ColumnSpacing="8">
              <TextBlock Text="{Binding Strings.TargetLanguage}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding OutLang}" />
            </Grid>

            <Grid Grid.Row="10" ColumnDefinitions="160,*" ColumnSpacing="8">
              <TextBlock Text="{Binding Strings.GuiLanguage}" VerticalAlignment="Center" />
              <ComboBox
                  Grid.Column="1"
                  ItemsSource="{Binding GuiLanguageOptions}"
                  SelectedItem="{Binding SelectedGuiLanguage}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GuiLanguageOption">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Grid>
          </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Border>
</Window>
